# Local PostgreSQL and Mailpit defaults for Docker Compose.
DATABASE_URL=postgres://frizzi:frizzi@localhost:5432/frizzi
APP_URL=http://localhost:5173
MAIL_FROM=no-reply@example.test
SMTP_HOST=localhost
SMTP_PORT=1025

# Optional development secrets. Set them in .env or in the server environment.
RESEND_API_KEY=
CRON_SECRET=
GEOAPIFY_API_KEY=
GEMINI_API_KEY=

# Optional SMTP settings. SMTP_TLS is none, starttls or tls (implicit TLS). When unset, localhost
# uses none, port 465 uses tls and any other host uses starttls (default port 587).
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional rate-limit settings. Forwarded client addresses are trusted from a proxy on loopback;
# FRIZZI_TRUST_PROXY=1 trusts any proxy and 0 never trusts them.
# FRIZZI_RATE_LIMIT_SCALE multiplies the per-IP limits.
FRIZZI_TRUST_PROXY=
FRIZZI_RATE_LIMIT_SCALE=

# Optional paths to the local Typst executable and fonts for PDF invitations.
FRIZZI_TYPST=
FRIZZI_PDF_FONTS=
