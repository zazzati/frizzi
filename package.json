{
  "name": "frizzi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev:full": "node scripts/dev.mjs",
    "services:native": "node scripts/native-services.mjs",
    "test:setup": "node scripts/setup-tools.mjs && playwright install chromium",
    "test": "node tests/run.mjs",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@sveltejs/adapter-node": "^6.0.4",
    "@sveltejs/adapter-vercel": "^7.0.4",
    "@sveltejs/kit": "^3.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "embedded-postgres": "16.15.0-beta.19",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.0.0",
    "clsx": "^2.1.1",
    "svelte-i18n": "^4.0.1",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^3.0.0"
  },
  "overrides": {
    "svelte-i18n": {
      "esbuild": "^0.28.0"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
